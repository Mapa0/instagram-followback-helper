{
  "manifest_version": 3,
  "name": "Instagram Followback Helper",
  "version": "1.0.4",
  "description": "Compara as listas da exportação e automatiza os unfollows pela interface do Instagram.",
  "permissions": ["storage", "clipboardWrite", "activeTab", "scripting"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Instagram Followback Helper",
    "default_popup": "popup.html"
  }
}
